# Copy this file to .env and fill in real values. Never commit .env.

# --- Pinecone (vector DB) ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=rag-app-index
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- OpenAI (embeddings + answer generation, via LangChain) ---
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- App ---
APP_ENV=dev
PORT=8000
